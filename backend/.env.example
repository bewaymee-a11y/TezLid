# Environment Variables Template
# Copy this file to .env and fill in your actual values

# MongoDB Configuration
MONGO_URL="mongodb://localhost:27017"
DB_NAME="test_database"

# CORS Settings (use * for development, specific origins for production)
CORS_ORIGINS="*"

# Base URL for webhooks (BYOB Multi-Tenant)
# For local testing with ngrok: https://xxxx.ngrok.io
# For production: https://your-domain.com
BASE_URL="http://localhost:8001"


# Emergent AI API Key
# Get your key from https://emergent-ai.com
EMERGENT_LLM_KEY=your_emergent_key_here

# Telegram Bot Configuration
# Get bot token from @BotFather in Telegram
# 1. Open @BotFather in Telegram
# 2. Send /newbot command
# 3. Follow instructions to create bot
# 4. Copy the token here
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Manager Chat ID for notifications
# Get your chat ID from @userinfobot or @getmyid_bot
# 1. Open @userinfobot in Telegram
# 2. Send any message
# 3. Copy the ID shown
MANAGER_CHAT_ID=your_chat_id_here

# Backend URL (used by bot_polling.py)
BACKEND_URL=http://localhost:8001

# CRM Integration Settings
CRM_WEBHOOK_SECRET=change_this_to_random_secret
CRM_RETRY_ATTEMPTS=3
CRM_TIMEOUT=30

# AmoCRM Configuration (optional)
AMOCRM_DOMAIN=
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_ACCESS_TOKEN=
AMOCRM_REFRESH_TOKEN=

# Bitrix24 Configuration (optional)
BITRIX24_WEBHOOK_URL=
